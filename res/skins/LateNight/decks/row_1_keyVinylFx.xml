<Template>
  <WidgetGroup>
    <ObjectName>DeckHeaderBar</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,max</SizePolicy>
    <Size>0me,28f</Size>
    <Children>

      <Label>
        <ObjectName>DeckBadge<Variable name="DeckLetter"/></ObjectName>
        <Size>76f,24f</Size>
        <Alignment>center</Alignment>
        <Text>[ <Variable name="DeckLetter"/> ]</Text>
      </Label>

      <WidgetGroup><Size>8f,0min</Size></WidgetGroup>

      <Label>
        <ObjectName>DeckStatusPlaying</ObjectName>
        <Size>76f,20f</Size>
        <Alignment>center</Alignment>
        <Text>PLAYING</Text>
        <Connection>
          <ConfigKey><Variable name="Group"/>,play</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </Label>

      <Label>
        <ObjectName>DeckStatusReady</ObjectName>
        <Size>60f,20f</Size>
        <Alignment>center</Alignment>
        <Text>READY</Text>
        <Connection>
          <ConfigKey><Variable name="Group"/>,play</ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </Label>

      <WidgetGroup><Size>0me,0min</Size></WidgetGroup>

      <WidgetGroup>
        <SizePolicy>me,min</SizePolicy>
        <MaximumSize>111,</MaximumSize>
        <Layout>vertical</Layout>
        <Children>
          <SingletonContainer>
            <ObjectName>KeyControls<Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Skin],show_key_controls</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>
    <Connection>
      <ConfigKey><Variable name="Group"/>,play</ConfigKey>
      <BindProperty>highlight</BindProperty>
    </Connection>
  </WidgetGroup><!-- DeckHeaderBar -->
</Template>
